OPENAI_API_KEY=sk-...
# Fineract access token (Keycloak bearer token)
BEARER_TOKEN=...
# Fineract API base URL when running the MCP server directly on your machine
API_URL=https://localhost:8443/fineract-provider/api/v1/
# Same API as seen from inside Docker (localhost there is the container itself)
FINERACT_DOCKER_API_URL=https://host.docker.internal:8443/fineract-provider/api/v1/
FINERACT_TENANT_ID=default
# Set to false for a local Fineract with a self-signed certificate
FINERACT_VERIFY_SSL=false
